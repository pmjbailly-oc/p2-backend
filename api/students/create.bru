meta {
  name: students create
  type: http
  seq: 5
}

post {
  url: http://localhost:8080/api/students
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "firstName": "Marie",
    "lastName": "Durand",
    "email": "marie.durand@example.com"
  }
}

script:post-response {
  const body = res.getBody();
  bru.setVar("studentId", body.id.toString());
  test("response status is 201", () => {
    expect(res.status).to.equal(201);
  });
  test("response returns the created student", () => {
    expect(body.id).to.be.a("number");
    expect(body.firstName).to.equal("Marie");
    expect(body.email).to.equal("marie.durand@example.com");
  });
}

settings {
  encodeUrl: true
}