meta {
  name: students list
  type: http
  seq: 6
}

get {
  url: http://localhost:8080/api/students
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:post-response {
  test("response status is 200", () => {
    expect(res.status).to.equal(200);
  });
  test("response is an array of students", () => {
    const body = res.getBody();
    expect(body).to.be.an("array");
  });
}

settings {
  encodeUrl: true
}